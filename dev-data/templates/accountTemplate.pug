nav.user-view__menu
  ul.side-nav
    li(class=`${activeTab === 'settings' ? 'side-nav--active' : ''}`)
      a(href='/me')
        svg
          use(xlink:href='/img/icons.svg#icon-settings')
        | Settings
    li(class=`${activeTab === 'my-bookings' ? 'side-nav--active' : ''}`)
      a(href='/my-tours')
        svg
          use(xlink:href='/img/icons.svg#icon-briefcase')
        | My bookings
    li(class=`${activeTab === 'my-reviews' ? 'side-nav--active' : ''}`)
      a(href='/my-reviews')
        svg
          use(xlink:href='/img/icons.svg#icon-star')
        | My reviews
    li(class=`${activeTab === 'billing' ? 'side-nav--active' : ''}`)
      a(href='#')
        svg
          use(xlink:href='/img/icons.svg#icon-credit-card')
        | Billing

  - if (user.role === 'admin')
    .admin-nav
      h5.admin-nav__heading Admin
      ul.side-nav
        li(class=`${activeTab === 'tours' ? 'side-nav--active' : ''}`)
          a(href='/manage-tours')
            svg
              use(xlink:href='/img/icons.svg#icon-map')
            | Manage tours
        li(class=`${activeTab === 'users' ? 'side-nav--active' : ''}`)
          a(href='/manage-users')
            svg
              use(xlink:href='/img/icons.svg#icon-users')
            | Manage users
        li(class=`${activeTab === 'reviews' ? 'side-nav--active' : ''}`)
          a(href='/manage-reviews')
            svg
              use(xlink:href='/img/icons.svg#icon-star')
            | Manage reviews
        li(class=`${activeTab === 'bookings' ? 'side-nav--active' : ''}`)
          a(href='/manage-bookings')
            svg
              use(xlink:href='/img/icons.svg#icon-briefcase')
            | Manage bookings