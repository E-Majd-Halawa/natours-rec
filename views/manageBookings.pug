extends base

mixin navItem(link, text, icon, active)
  li(class=`${active ? 'side-nav--active' : ''}`)
    a(href=`${link}`)
      svg
        use(xlink:href=`/img/icons.svg#icon-${icon}`)
      | #{text}

block content
  main.main
    .user-view
      nav.user-view__menu
        ul.side-nav
          +navItem('/me', 'Settings', 'settings', false)
          +navItem('/my-tours', 'My bookings', 'briefcase', false)
          +navItem('/my-reviews', 'My reviews', 'star', false)
          +navItem('/billing', 'Billing', 'credit-card', false)

        if user && user.role === 'admin'
          .admin-nav
            h5.admin-nav__heading Admin
            ul.side-nav
              +navItem('/manage-tours', 'Manage tours', 'map', false)
              +navItem('/manage-users', 'Manage users', 'users', false)
              +navItem('/manage-reviews', 'Manage reviews', 'star', false)
              +navItem('/manage-bookings', 'Manage bookings', 'briefcase', true)
              +navItem('/manage-applications', 'Manage Applications', 'file-text', false)
              +navItem('/manage-contacts', 'Contact Messages', 'mail', false)

      .user-view__content
        .billing-container
          .billing-header
            h2.heading-secondary Manage Bookings
            p.billing-subtitle Track and manage every booking made across all tours.

          - const totalBookings = bookings ? bookings.length : 0
          - const totalRevenue = bookings ? bookings.reduce((acc, b) => acc + (b.price || 0), 0) : 0
          - const unpaidCount = bookings ? bookings.filter(b => b.paid === false).length : 0

          .billing-metrics
            .metric-box
              span.metric-box__label Total Bookings
              span.metric-box__value= totalBookings
            .metric-box
              span.metric-box__label Total Revenue
              span.metric-box__value= `$${totalRevenue}`
            .metric-box
              span.metric-box__label Unpaid
              span.metric-box__value= unpaidCount

          .billing-section
            h3.billing-section__title All Bookings

            if !bookings || bookings.length === 0
              p.form__hint No bookings found in the system.
            else
              .billing-list
                each booking in bookings
                  - const bookingId = booking._id || booking.id
                  .billing-row(data-booking-id=bookingId)
                    .billing-row__info
                      h4.billing-row__title= booking.tour ? booking.tour.name : 'Deleted Tour'
                      .billing-row__meta
                        span= booking.user ? booking.user.name : 'Deleted User'
                        span.meta-dot •
                        span= new Date(booking.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })

                    if booking.paid === false
                      span.status-pill.status-pill--pending Unpaid
                    else
                      span.status-pill.status-pill--paid Paid

                    span.amount-text= `$${booking.price}`

                    button.btn-action.btn-action--delete.btn--delete-booking(
                      type='button',
                      data-booking-id=bookingId
                    ) Delete

block append scripts
  script(src='https://cdnjs.cloudflare.com/ajax/libs/axios/1.6.8/axios.min.js')
  script.
    const bookingsList = document.querySelector('.billing-list');

    if (bookingsList) {
      bookingsList.addEventListener('click', async (e) => {
        const deleteBtn = e.target.closest('.btn--delete-booking');
        if (!deleteBtn) return;

        const bookingId = deleteBtn.dataset.bookingId;

        if (!confirm('Are you sure you want to delete this booking?')) return;

        try {
          deleteBtn.disabled = true;
          deleteBtn.textContent = 'Deleting...';

          const res = await axios({
            method: 'DELETE',
            url: `/api/v1/bookings/${bookingId}`,
          });

          if (res.status === 204 || res.data?.status === 'success') {
            const row = deleteBtn.closest('.billing-row');
            if (row) {
              row.remove();
            } else {
              window.location.reload();
            }
          }
        } catch (err) {
          deleteBtn.disabled = false;
          deleteBtn.textContent = 'Delete';
          alert(`Error: ${err.response?.data?.message || err.message}`);
        }
      });
    }