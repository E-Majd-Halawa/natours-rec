extends base

mixin navItem(link, text, icon, active)
  li(class=`${active ? 'side-nav--active' : ''}`)
    a(href=`${link}`)
      svg
        use(xlink:href=`/img/icons.svg#icon-${icon}`)
      | #{text}

block content
  main.main
    .user-view
      nav.user-view__menu
        ul.side-nav
          +navItem('/me', 'Settings', 'settings')
          +navItem('/my-tours', 'My bookings', 'briefcase')
          +navItem('/my-reviews', 'My reviews', 'star', true)
          +navItem('/billing', 'Billing', 'credit-card')
        if user && user.role === 'admin'
          .admin-nav
            h5.admin-nav__heading Admin
            ul.side-nav
              +navItem('/manage-tours', 'Manage tours', 'map')
              +navItem('/manage-users', 'Manage users', 'users')
              +navItem('/manage-reviews', 'Manage reviews', 'star')
              +navItem('/manage-bookings', 'Manage bookings', 'briefcase')

      .user-view__content
        .reviews-container
          .reviews-header
            h2.heading-secondary My Reviews
            p.reviews-subtitle View, manage, and track all the tour reviews you have submitted.

          - const totalReviews = reviews ? reviews.length : 0
          - const avgRating = totalReviews ? (reviews.reduce((acc, r) => acc + r.rating, 0) / totalReviews).toFixed(1) : '0.0'

          // --- 1. Metrics Bar ---
          .reviews-metrics
            .metric-box
              span.metric-box__label Total Reviews
              span.metric-box__value= totalReviews
            .metric-box
              span.metric-box__label Average Rating Given
              span.metric-box__value= `${avgRating} ★`

          // --- 2. Minimalist Reviews List ---
          .reviews-section
            h3.reviews-section__title Review History

            if !reviews || reviews.length === 0
              p.no-data You haven't written any reviews yet.
            else
              .reviews-list
                each review in reviews
                  .review-card(data-review-id=`${review.id}`)
                    .review-card__header
                      .review-card__tour-info
                        h4.review-card__title= review.tour ? review.tour.name : 'Tour Review'
                        span.review-card__date= new Date(review.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
                      
                      .review-card__rating
                        span.rating-badge= `${review.rating} / 5 ★`

                    .review-card__body
                      p.review-card__text= review.review

                    .review-card__footer
                      if review.tour
                        a.btn-action.btn-action--view(href=`/tour/${review.tour.slug}`) View Tour
                      button.btn-action.btn-action--delete.btn-delete-review(data-id=`${review.id}`) Delete