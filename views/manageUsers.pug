extends base

mixin navItem(link, text, icon, active)
  li(class=`${active ? 'side-nav--active' : ''}`)
    a(href=`${link}`)
      svg
        use(xlink:href=`/img/icons.svg#icon-${icon}`)
      | #{text}

block content
  main.main
    .user-view
      nav.user-view__menu
        ul.side-nav
          +navItem('/me', 'Settings', 'settings', false)
          +navItem('/my-tours', 'My bookings', 'briefcase', false)
          +navItem('/my-reviews', 'My reviews', 'star', false)
          +navItem('/billing', 'Billing', 'credit-card', false)

        - if (user && user.role === 'admin')
          .admin-nav
            h5.admin-nav__heading Admin
            ul.side-nav
              +navItem('/manage-tours', 'Manage tours', 'map', false)
              +navItem('/manage-users', 'Manage users', 'users', true)
              +navItem('/manage-reviews', 'Manage reviews', 'star', false)
              +navItem('/manage-bookings', 'Manage bookings', 'briefcase', false)
              +navItem('/manage-applications', 'Manage Applications', 'file-text', false)
              +navItem('/manage-contacts', 'Contact Messages', 'mail', false)

      .user-view__content
        .user-view__form-container(style="max-width: 100rem;")
          h2.heading-secondary.ma-bt-md Manage All Users

          if !users || users.length === 0
            p.no-data(style="font-size: 1.6rem; color: #777; margin-top: 3rem; text-align: center;") No users found in the system.
          else
            table.table-users(style="width: 100%; border-collapse: collapse; background: #fff; box-shadow: 0 1.5rem 4rem rgba(0,0,0,0.1); border-radius: 9px; overflow: hidden;")
              thead(style="background-color: #55c57a; color: #fff;")
                tr
                  th(style="padding: 1.5rem; text-align: left;") Photo
                  th(style="padding: 1.5rem; text-align: left;") Name
                  th(style="padding: 1.5rem; text-align: left;") Email
                  th(style="padding: 1.5rem; text-align: left;") Role
                  th(style="padding: 1.5rem; text-align: center;") Actions
              tbody
                each usr in users
                  - const userId = usr._id || usr.id
                  tr(style="border-bottom: 1px solid #eee;", data-user-id=userId)
                    td(style="padding: 1.2rem;")
                      - const photoSrc = usr.photo && usr.photo.startsWith('data:') ? usr.photo : `/img/users/${usr.photo || 'default.jpg'}`
                      img(src=photoSrc, alt=usr.name, style="height: 4rem; width: 4rem; border-radius: 50%; object-fit: cover;")
                    td(style="padding: 1.2rem;")= usr.name
                    td(style="padding: 1.2rem;")= usr.email
                    td(style="padding: 1.2rem;")
                      span(style=`padding: 0.4rem 0.8rem; border-radius: 100px; font-size: 1.2rem; font-weight: 700; background-color: ${usr.role === 'admin' ? '#e74c3c' : '#28b487'}; color: #fff;`)= usr.role.toUpperCase()
                    td(style="padding: 1.2rem; text-align: center;")
                      button.btn.btn--small.btn--red.btn--delete-user(data-user-id=userId, style="background-color: #ff5252; color: #fff;") Delete

  script(src='https://cdnjs.cloudflare.com/axios/1.6.8/axios.min.js')
  script.
    document.addEventListener('click', async (e) => {
      const deleteBtn = e.target.closest('.btn--delete-user');
      if (deleteBtn) {
        e.preventDefault();
        const userId = deleteBtn.dataset.userId;

        if (!confirm('Are you sure you want to delete this user permanently?')) return;

        try {
          deleteBtn.disabled = true;
          deleteBtn.textContent = 'Deleting...';

          const res = await axios({
            method: 'DELETE',
            url: `/api/v1/users/${userId}`
          });

          if (res.status === 204 || res.data?.status === 'success') {
            const row = deleteBtn.closest('tr');
            if (row) {
              row.remove();
            } else {
              window.location.reload();
            }
          }
        } catch (err) {
          deleteBtn.disabled = false;
          deleteBtn.textContent = 'Delete';
          alert(`Error: ${err.response?.data?.message || err.message}`);
        }
      }
    });