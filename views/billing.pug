extends base

mixin navItem(link, text, icon, active)
  li(class=`${active ? 'side-nav--active' : ''}`)
    a(href=`${link}`)
      svg
        use(xlink:href=`/img/icons.svg#icon-${icon}`)
      | #{text}

block content
  main.main
    .user-view
      nav.user-view__menu
        ul.side-nav
          +navItem('/me', 'Settings', 'settings')
          +navItem('/my-tours', 'My bookings', 'briefcase')
          +navItem('/my-reviews', 'My reviews', 'star')
          +navItem('/billing', 'Billing', 'credit-card', true)
        if user && user.role === 'admin'
          .admin-nav
            h5.admin-nav__heading Admin
            ul.side-nav
              +navItem('/manage-tours', 'Manage tours', 'map')
              +navItem('/manage-users', 'Manage users', 'users')
              +navItem('/manage-reviews', 'Manage reviews', 'star')
              +navItem('/manage-bookings', 'Manage bookings', 'briefcase')

      .user-view__content
        .billing-container
          .billing-header
            h2.heading-secondary Billing & Invoices
            p.billing-subtitle Manage your tour transaction history and download receipts.

          - const totalSpent = bookings ? bookings.reduce((sum, b) => sum + (b.price || 0), 0) : 0

          // --- 1. Metrics Bar ---
          .billing-metrics
            .metric-box
              span.metric-box__label Total Spent
              span.metric-box__value= `$${totalSpent.toFixed(2)}`
            .metric-box
              span.metric-box__label Invoices Issued
              span.metric-box__value= bookings ? bookings.length : 0

          // --- 2. Minimalist History List ---
          .billing-section
            h3.billing-section__title Transaction History

            if !bookings || bookings.length === 0
              p.no-data No billing history found.
            else
              .billing-list
                each booking, i in bookings
                  .billing-row
                    .billing-row__info
                      h4.billing-row__title= booking.tour ? booking.tour.name : 'Tour Booking'
                      .billing-row__meta
                        span.invoice-id= `#INV-${new Date(booking.createdAt).getFullYear()}-${(i + 1).toString().padStart(3, '0')}`
                        span.meta-dot •
                        span.payment-date= new Date(booking.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
                    
                    .billing-row__status
                      if booking.paid !== false
                        span.status-pill.status-pill--paid Paid
                      else
                        span.status-pill.status-pill--pending Pending
                    
                    .billing-row__amount
                      span.amount-text= `$${booking.price.toFixed(2)}`
                    
                    .billing-row__action
                      button.btn-receipt(onclick="window.print()") Receipt