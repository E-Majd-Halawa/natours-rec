extends base

mixin navItem(link, text, icon, active)
  li(class=`${active ? 'side-nav--active' : ''}`)
    a(href=`${link}`)
      svg
        use(xlink:href=`/img/icons.svg#icon-${icon}`)
      | #{text}

block content
  main.main
    .user-view
      nav.user-view__menu
        ul.side-nav
          +navItem('/me', 'Settings', 'settings')
          +navItem('/my-tours', 'My bookings', 'briefcase')
          +navItem('/my-reviews', 'My reviews', 'star')
          +navItem('/billing', 'Billing', 'credit-card', true)
        if user.role === 'admin'
          .admin-nav
            h5.admin-nav__heading Admin
            ul.side-nav
              +navItem('/manage-tours', 'Manage tours', 'map')
              +navItem('/manage-users', 'Manage users', 'users')
              +navItem('/manage-reviews', 'Manage reviews', 'star')
              +navItem('/manage-bookings', 'Manage bookings', 'briefcase')

      .user-view__content
        .billing-dashboard
          .billing-header
            h2.heading-secondary Billing & Payment History
            p.billing-subtitle Track your payments, view invoices, and manage your tour transactions.

          // --- 1. كروت الملخص المالي (Stats Cards) ---
          - const totalSpent = bookings ? bookings.reduce((sum, b) => sum + (b.price || 0), 0) : 0
          - const paidCount = bookings ? bookings.filter(b => b.paid !== false).length : 0

          .billing-stats
            .stat-card
              .stat-card__icon.stat-card__icon--green
                svg
                  use(xlink:href='/img/icons.svg#icon-credit-card')
              .stat-card__info
                span.stat-card__label Total Spent
                h3.stat-card__value `$${totalSpent.toLocaleString('en-US', { minimumFractionDigits: 2 })}`

            .stat-card
              .stat-card__icon.stat-card__icon--blue
                svg
                  use(xlink:href='/img/icons.svg#icon-briefcase')
              .stat-card__info
                span.stat-card__label Total Invoices
                h3.stat-card__value= bookings ? bookings.length : 0

            .stat-card
              .stat-card__icon.stat-card__icon--star
                svg
                  use(xlink:href='/img/icons.svg#icon-star')
              .stat-card__info
                span.stat-card__label Paid Orders
                h3.stat-card__value= paidCount

          // --- 2. جدول الفواتير الحديث (Modern Table) ---
          if !bookings || bookings.length === 0
            .billing-empty
              p.no-data No billing records found yet.
          else
            .table-container
              table.modern-table
                thead
                  tr
                    th Invoice ID
                    th Tour Item
                    th Payment Date
                    th Amount
                    th Status
                    th Action
                tbody
                  each booking, i in bookings
                    tr
                      td.font-mono
                        span.invoice-tag= `#INV-${new Date(booking.createdAt).getFullYear()}-${(i + 1).toString().padStart(3, '0')}`
                      td.tour-cell
                        .tour-name= booking.tour ? booking.tour.name : 'Custom Tour Package'
                      td.date-cell
                        = new Date(booking.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
                      td.amount-cell
                        span.price-amount `$${booking.price}`
                      td
                        if booking.paid !== false
                          span.badge.badge--paid Paid
                        else
                          span.badge.badge--pending Pending
                      td
                        button.btn-action(onclick="window.print()") Receipt