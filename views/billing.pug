extends base

mixin navItem(link, text, icon, active)
  li(class=`${active ? 'side-nav--active' : ''}`)
    a(href=`${link}`)
      svg
        use(xlink:href=`/img/icons.svg#icon-${icon}`)
      | #{text}

block content
  main.main
    .user-view
      nav.user-view__menu
        ul.side-nav
          +navItem('/me', 'Settings', 'settings')
          +navItem('/my-tours', 'My bookings', 'briefcase')
          +navItem('/my-reviews', 'My reviews', 'star')
          +navItem('/billing', 'Billing', 'credit-card', true)
        if user.role === 'admin'
          .admin-nav
            h5.admin-nav__heading Admin
            ul.side-nav
              +navItem('/manage-tours', 'Manage tours', 'map')
              +navItem('/manage-users', 'Manage users', 'users')
              +navItem('/manage-reviews', 'Manage reviews', 'star')
              +navItem('/manage-bookings', 'Manage bookings', 'briefcase')

      .user-view__content
        .user-view__form-container
          h2.heading-secondary.ma-bt-md Billing & Payment History

          if !bookings || bookings.length === 0
            p.no-data No billing history found.
          else
            table.table-billing
              thead
                tr
                  th Item / Tour
                  th Date
                  th Amount
                  th Status
                  th Method
              tbody
                each booking in bookings
                  tr
                    td= booking.tour ? booking.tour.name : 'Tour Package'
                    td= new Date(booking.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
                    td $#{booking.price}
                    td
                      span(class=`status-tag ${booking.paid !== false ? 'status-paid' : 'status-pending'}`)
                        = booking.paid !== false ? 'Paid' : 'Unpaid'
                    td Credit Card (Stripe)