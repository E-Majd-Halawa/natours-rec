extends base

mixin navItem(link, text, icon, active)
  li(class=`${active ? 'side-nav--active' : ''}`)
    a(href=`${link}`)
      svg
        use(xlink:href=`/img/icons.svg#icon-${icon}`)
      | #{text}

block content
  main.main
    .user-view
      nav.user-view__menu
        ul.side-nav
          +navItem('/me', 'Settings', 'settings')
          +navItem('/my-tours', 'My bookings', 'briefcase')
          +navItem('/my-reviews', 'My reviews', 'star')
          +navItem('/billing', 'Billing', 'credit-card', true)
        if user && user.role === 'admin'
          .admin-nav
            h5.admin-nav__heading Admin
            ul.side-nav
              +navItem('/manage-tours', 'Manage tours', 'map')
              +navItem('/manage-users', 'Manage users', 'users')
              +navItem('/manage-reviews', 'Manage reviews', 'star')
              +navItem('/manage-bookings', 'Manage bookings', 'briefcase')

      .user-view__content
        .billing-container
          .billing-header
            h2.heading-secondary Billing History
            p.billing-subtitle Review your past payments and keep track of every booking invoice.

          - const totalBookings = bookings ? bookings.length : 0
          - const totalSpent = bookings ? bookings.reduce((acc, b) => acc + (b.price || 0), 0) : 0
          - const paidCount = bookings ? bookings.filter(b => b.paid !== false).length : 0

          // --- 1. Metrics Bar ---
          .billing-metrics
            .metric-box
              span.metric-box__label Total Spent
              span.metric-box__value= `$${totalSpent}`
            .metric-box
              span.metric-box__label Total Bookings
              span.metric-box__value= totalBookings
            .metric-box
              span.metric-box__label Paid Invoices
              span.metric-box__value= paidCount

          // --- 2. Transactions List ---
          .billing-section
            h3.billing-section__title Transaction History

            if !bookings || bookings.length === 0
              p.form__hint You don't have any billing history yet.
            else
              .billing-list
                each booking in bookings
                  .billing-row(data-booking-id=`${booking.id}`)
                    .billing-row__info
                      h4.billing-row__title= booking.tour ? booking.tour.name : 'Tour Booking'
                      .billing-row__meta
                        span.invoice-id= `#${booking.id.slice(-8).toUpperCase()}`
                        span.meta-dot •
                        span= new Date(booking.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })

                    if booking.paid === false
                      span.status-pill.status-pill--pending Pending
                    else
                      span.status-pill.status-pill--paid Paid

                    span.amount-text= `$${booking.price}`

                    button.btn-receipt(type='button', data-id=`${booking.id}`) View Receipt
