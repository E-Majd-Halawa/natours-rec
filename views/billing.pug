extends base

mixin navItem(link, text, icon, active)
  li(class=`${active ? 'side-nav--active' : ''}`)
    a(href=`${link}`)
      svg
        use(xlink:href=`/img/icons.svg#icon-${icon}`)
      | #{text}

block content
  main.main
    .user-view
      nav.user-view__menu
        ul.side-nav
          +navItem('/me', 'Settings', 'settings')
          +navItem('/my-tours', 'My bookings', 'briefcase')
          +navItem('/my-reviews', 'My reviews', 'star')
          +navItem('/billing', 'Billing', 'credit-card', true)
        if user && user.role === 'admin'
          .admin-nav
            h5.admin-nav__heading Admin
            ul.side-nav
              +navItem('/manage-tours', 'Manage tours', 'map')
              +navItem('/manage-users', 'Manage users', 'users')
              +navItem('/manage-reviews', 'Manage reviews', 'star')
              +navItem('/manage-bookings', 'Manage bookings', 'briefcase')

      .user-view__content
        .billing-container(data-user-name=user ? user.name : '', data-user-email=user ? user.email : '')
          .billing-header
            h2.heading-secondary Billing History
            p.billing-subtitle Review your past payments and keep track of every booking invoice.

          - const totalBookings = bookings ? bookings.length : 0
          - const totalSpent = bookings ? bookings.reduce((acc, b) => acc + (b.price || 0), 0) : 0
          - const paidCount = bookings ? bookings.filter(b => b.paid !== false).length : 0

          // --- 1. Metrics Bar ---
          .billing-metrics
            .metric-box
              span.metric-box__label Total Spent
              span.metric-box__value= `$${totalSpent}`
            .metric-box
              span.metric-box__label Total Bookings
              span.metric-box__value= totalBookings
            .metric-box
              span.metric-box__label Paid Invoices
              span.metric-box__value= paidCount

          // --- 2. Transactions List ---
          .billing-section
            h3.billing-section__title Transaction History

            if !bookings || bookings.length === 0
              p.form__hint You don't have any billing history yet.
            else
              .billing-list
                each booking in bookings
                  - const invoiceId = `INV-${booking.id.slice(-8).toUpperCase()}`
                  .billing-row(data-booking-id=`${booking.id}`)
                    .billing-row__info
                      h4.billing-row__title= booking.tour ? booking.tour.name : 'Tour Booking'
                      .billing-row__meta
                        span.invoice-id= `#${invoiceId}`
                        span.meta-dot •
                        span= new Date(booking.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })

                    if booking.paid === false
                      span.status-pill.status-pill--pending Pending
                    else
                      span.status-pill.status-pill--paid Paid

                    span.amount-text= `$${booking.price}`

                    button.btn-receipt(
                      type='button',
                      data-invoice=invoiceId,
                      data-tour=booking.tour ? booking.tour.name : 'Tour Booking',
                      data-price=booking.price,
                      data-date=booking.createdAt.toISOString(),
                      data-paid=booking.paid !== false
                    ) View Receipt

    // --- Receipt Modal (printable) ---
    #receiptModal.receipt-modal
      .receipt-modal__overlay
      .receipt-modal__box
        button#receiptCloseX.receipt-modal__close(type='button', aria-label='Close') ×
        .receipt-printable
          .receipt-printable__header
            .receipt-printable__brand
              img.receipt-printable__logo(src='/img/logo-green.png', alt='Natours')
              span.receipt-printable__brand-name Natours
            .receipt-printable__meta
              h3 Receipt
              span#receiptInvoiceId.receipt-printable__invoice-id
          .receipt-printable__divider
          .receipt-printable__row
            span.receipt-printable__label Billed to
            span#receiptCustomerName.receipt-printable__value
          .receipt-printable__row
            span.receipt-printable__label Email
            span#receiptCustomerEmail.receipt-printable__value
          .receipt-printable__row
            span.receipt-printable__label Date
            span#receiptDate.receipt-printable__value
          .receipt-printable__row
            span.receipt-printable__label Tour
            span#receiptTour.receipt-printable__value
          .receipt-printable__row
            span.receipt-printable__label Status
            span#receiptStatus.receipt-printable__value
          .receipt-printable__divider
          .receipt-printable__total
            span Total Paid
            span#receiptAmount
        .receipt-modal__actions
          button#receiptPrintBtn.btn-action.btn-action--view(type='button') Print
          button#receiptCloseBtn.btn-action(type='button') Close

block append scripts
  script(src='/js/billing.js')
