extends base

mixin navItem(link, text, icon, active)
  li(class=`${active ? 'side-nav--active' : ''}`)
    a(href=`${link}`)
      svg
        use(xlink:href=`/img/icons.svg#icon-${icon}`)
      | #{text}

block content
  main.main
    .user-view
      nav.user-view__menu
        ul.side-nav
          +navItem('/me', 'Settings', 'settings', false)
          +navItem('/my-tours', 'My bookings', 'briefcase', false)
          +navItem('/my-reviews', 'My reviews', 'star', false)
          +navItem('/billing', 'Billing', 'credit-card', false)

        - if (user && user.role === 'admin')
          .admin-nav
            h5.admin-nav__heading Admin
            ul.side-nav
              +navItem('/manage-tours', 'Manage tours', 'map', false)
              +navItem('/manage-users', 'Manage users', 'users', false)
              +navItem('/manage-reviews', 'Manage reviews', 'star', false)
              +navItem('/manage-bookings', 'Manage bookings', 'briefcase', false)
              +navItem('/manage-applications', 'Manage Applications', 'file-text', false)
              +navItem('/manage-contacts', 'Contact Messages', 'mail', true)

      .user-view__content
        .user-view__form-container
          h2.heading-secondary.ma-bt-md Manage Contact Messages

          if contacts && contacts.length > 0
            table.table.table--contacts(style="width: 100%; border-collapse: collapse; margin-top: 2rem;")
              thead
                tr(style="background-color: #f7f7f7; text-align: left; border-bottom: 2px solid #e0e0e0;")
                  th(style="padding: 1.2rem;") Sender Name
                  th(style="padding: 1.2rem;") Email
                  th(style="padding: 1.2rem;") Subject
                  th(style="padding: 1.2rem;") Message
                  th(style="padding: 1.2rem; text-align: center;") Action

              tbody
                each msg in contacts
                  tr(style="border-bottom: 1px solid #eee;")
                    td(style="padding: 1.2rem; font-weight: 600;")= msg.name
                    td(style="padding: 1.2rem;")= msg.email
                    td(style="padding: 1.2rem; font-weight: 600; color: #55c57a;")= msg.subject
                    td(style="padding: 1.2rem; max-width: 250px; font-size: 1.3rem; color: #555;")= msg.message
                    td(style="padding: 1.2rem; text-align: center;")
                      button.btn.btn--small.btn--delete-contact(data-contact-id=`${msg._id}`, style="background-color: #ff5252; color: #fff;") Delete
          else
            p.text-center(style="font-size: 1.6rem; color: #777; margin-top: 3rem;") No contact messages received yet.

  script(src='https://cdnjs.cloudflare.com/ajax/libs/axios/1.6.8/axios.min.js')
  script.
    document.addEventListener('click', async (e) => {
      const deleteBtn = e.target.closest('.btn--delete-contact');
      if (deleteBtn) {
        e.preventDefault();
        const contactId = deleteBtn.dataset.contactId;

        if (!confirm('Are you sure you want to delete this message?')) return;

        try {
          deleteBtn.disabled = true;
          deleteBtn.textContent = 'Deleting...';

          const res = await axios({
            method: 'DELETE',
            url: `/api/v1/contact/${contactId}`
          });

          if (res.data.status === 'success') {
            window.location.reload();
          }
        } catch (err) {
          deleteBtn.disabled = false;
          deleteBtn.textContent = 'Delete';
          alert(`Error: ${err.response?.data?.message || err.message}`);
        }
      }
    });