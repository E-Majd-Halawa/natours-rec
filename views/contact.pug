extends base

mixin contactCard(icon, title, detail, link)
  .contact-card
    .contact-card__icon
      svg
        use(xlink:href=`/img/icons.svg#icon-${icon}`)
    h3.contact-card__title= title
    if link
      a.contact-card__link(href=link target='_blank')= detail
    else
      p.contact-card__detail= detail

block content
  main.main
    .contact-container
      .contact-header
        h1.heading-primary Contact Us
        p.contact-header__subtext
          | Have questions, feedback, or need help with a booking? Send us a message and our team will get back to you shortly.

      .contact-content
        //- بطاقات معلومات التواصل
        .contact-info
          +contactCard('mail', 'Email Us', 'support@natours.com', 'mailto:support@natours.com')
          +contactCard('phone', 'Call Us', '+1 (555) 000-1234', 'tel:+15550001234')
          +contactCard('map-pin', 'Location', 'San Francisco, CA, USA')

        //- فورم إرسال الرسالة
        .contact-form-box
          h2.heading-secondary.ma-bt-md Send a Message
          form.form.form-contact#contact-form
            .form__group--float
              input#name.form__input(type='text', required, name='name', value=`${user.name}`, readonly)
              label.form__label(for='name') Your Name
            
            .form__group--float
              input#email.form__input(type='email', required, name='email', value=`${user.email}`, readonly)
              label.form__label(for='email') Email Address
            
            .form__group--float
              input#subject.form__input(type='text', placeholder=' ', required, name='subject')
              label.form__label(for='subject') Subject

            .form__group--float
              textarea#message.form__input(rows='5', placeholder=' ', required, name='message', style='resize: vertical; min-height: 120px;')
              label.form__label(for='message') Your Message

            .form__group.right
              button.btn.btn--green.btn--send-message(type='submit') Send Message 🚀