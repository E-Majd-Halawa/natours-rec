extends base

block append head
    // مكتبة Leaflet لرسم الخريطة
    link(rel='stylesheet', href='https://unpkg.com/leaflet@1.9.4/dist/leaflet.css')
    script(src='https://unpkg.com/leaflet@1.9.4/dist/leaflet.js')
    script(src='https://js.stripe.com/v3/')

mixin overviewBox(label, text, icon)
    .overview-box__detail
        svg.overview-box__icon
            use(xlink:href=`/img/icons.svg#icon-${icon}`)
        span.overview-box__label= label
        span.overview-box__text= text

include _reviewCard

block content
    section.section-header
        .header__hero
            .header__hero-overlay &nbsp;
            img.header__hero-img(src=`/img/tours/${tour.imageCover}`, alt=tour.name)
            .ridge
                svg(viewBox='0 0 1200 60' preserveAspectRatio='none')
                    path(fill='#F5F7F1' d='M0 60 L0 34 L60 20 L140 42 L230 10 L320 38 L410 16 L500 44 L600 22 L700 46 L800 18 L900 40 L1000 14 L1100 38 L1200 24 L1200 60 Z')
        .heading-box
            span.heading-box__eyebrow= `${tour.difficulty} · ${tour.duration}-day tour`
            h1.heading-primary= `${tour.name} Tour`
            .heading-box__group
                .heading-box__detail
                    svg.heading-box__icon
                        use(xlink:href='/img/icons.svg#icon-clock')
                    span.heading-box__text= `${tour.duration} days`
                .heading-box__detail
                    svg.heading-box__icon
                        use(xlink:href='/img/icons.svg#icon-map-pin')
                    span.heading-box__text= tour.startLocation ? tour.startLocation.description : 'Location TBA'

    section.section-description
        .overview-box
            .overview-box__group
                h2.heading-secondary.ma-bt-lg Quick facts
                - const date = (tour.startDates && tour.startDates.length) ? tour.startDates[0].toLocaleString('en-us',{month:'long',year:'numeric'}) : 'Date TBA'
                +overviewBox('Next date', date, 'calendar')
                +overviewBox('Difficulty', tour.difficulty, 'trending-up')
                +overviewBox('Participants', `${tour.maxGroupSize} People`, 'user')
                +overviewBox('Rating', `${tour.ratingsAverage} / 5`, 'star')

            .overview-box__group
                h2.heading-secondary.ma-bt-lg Your tour guides
                if tour.guides && tour.guides.length
                    each guide in tour.guides
                        .overview-box__detail
                            img.overview-box__img(src=`/img/users/${guide.photo || 'default.jpg'}`, alt=guide.name)
                            if guide.role === 'lead-guide'
                                span.overview-box__label Lead guide
                            if guide.role === 'guide'
                                span.overview-box__label Tour guide
                            span.overview-box__text= guide.name
                else
                    p.overview-box__text No guides assigned yet.

        .description-box
            h2.heading-secondary.ma-bt-lg= `About ${tour.name} tour`
            - const paragraphs = tour.description ? tour.description.split('\n') : ['No description available.']
            each p in paragraphs
                p.description__text= p

    section.section-pictures
        if tour.images && tour.images.length
            each img, i in tour.images
                .picture-box
                    img.picture-box__img(src=`/img/tours/${img}`, alt=`${tour.name} ${i+1}`, class=`picture-box__img--${i+1}`, loading='lazy')

    section.section-map
        h2.heading-secondary.ma-bt-lg.section-map__heading Route
        // fallback: إذا كانت locations فارغة نمرر startLocation لتظهر على الخريطة
        - const mapLocations = (tour.locations && tour.locations.length) ? tour.locations : (tour.startLocation ? [tour.startLocation] : [])
        #map(data-locations=`${JSON.stringify(mapLocations)}`)

    section.section-reviews
        h2.heading-secondary.ma-bt-lg.section-reviews__heading What explorers are saying
        .reviews-wrapper
            button.reviews__btn.reviews__btn--left(aria-label='Previous review') ‹
            .reviews
                if tour.reviews && tour.reviews.length
                    each review in tour.reviews
                        +reviewCard(review)
                else
                    p.overview-box__text No reviews yet.
            button.reviews__btn.reviews__btn--right(aria-label='Next review') ›

        if user
            .add-review-box
                h2.heading-secondary.ma-bt-md Leave your review
                form.form.form--review#review-form(data-tour-id=`${tour.id}`)
                    .form__group
                        label.form__label(for='rating') Rating
                        select#rating.form__input(required)
                            option(value='5') ⭐⭐⭐⭐⭐ (5/5 - Excellent)
                            option(value='4') ⭐⭐⭐⭐☆ (4/5 - Very Good)
                            option(value='3') ⭐⭐⭐☆☆ (3/5 - Good)
                            option(value='2') ⭐⭐☆☆☆ (2/5 - Fair)
                            option(value='1') ⭐☆☆☆☆ (1/5 - Poor)
                    .form__group
                        label.form__label(for='review') Your Review
                        textarea#review.form__input(rows='4', placeholder='Share your experience with this tour...', required)
                    .form__group
                        button.btn.btn--green Submit Review

    section.section-cta
        .cta
            .cta__img.cta__img--logo
                img(src='/img/logo-white.png', alt='Natours logo')
            if tour.images && tour.images[1]
                img.cta__img.cta__img--1(src=`/img/tours/${tour.images[1]}`, alt='Tour picture')
            if tour.images && tour.images[2]
                img.cta__img.cta__img--2(src=`/img/tours/${tour.images[2]}`, alt='Tour picture')
            .cta__content
                h2.heading-secondary What are you waiting for?
                p.cta__text= `${tour.duration} days. 1 adventure. Infinite memories. Make it yours today!`
                if user
                    button.btn.btn--green.span-all-rows#book-tour(data-tour-id=`${tour.id}`) Book tour now!
                else
                    a.btn.btn--green.span-all-rows(href='/loginForm') Log in to book tour now!

block append scripts
    script(src='https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js')
    script(type='module', src='/js/displayMap.js')
    script(src='/js/reviewCarousel.js')
    script(src='/js/addReview.js')