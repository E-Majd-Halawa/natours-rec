extends base

block content
    main.main
        .auth
            .auth__art
                svg.auth__contours(viewBox='0 0 600 800' preserveAspectRatio='none')
                    g(fill='none' stroke='#3C7A55' stroke-width='1')
                        path(d='M-50 700 Q 150 620 300 680 T 650 640' opacity='.55')
                        path(d='M-50 600 Q 180 520 330 580 T 680 540' opacity='.4')
                        path(d='M-50 500 Q 200 420 350 480 T 700 440' opacity='.28')
                        path(d='M-50 400 Q 220 330 370 380 T 720 340' opacity='.18')
                .auth__art-content
                    a.auth__brand(href='/')
                        svg(width='26' height='26' viewBox='0 0 24 24')
                            circle(cx='12' cy='12' r='9' fill='none' stroke='currentColor' stroke-width='1.8')
                            path(fill='currentColor' d='M15.5 8.5l-2 5-5 2 2-5z')
                        | Natours
                    h2.auth__quote Your next trail #[em starts here.]
                    p.auth__quote-sub Create an account to save tours, track bookings, and get first pick on new dates.
                .ridge.ridge--vertical
                    svg(viewBox='0 0 24 320' preserveAspectRatio='none')
                        path(fill='#FFFFFF' d='M24 0 L14 0 L6 16 L18 38 L3 62 L16 88 L5 112 L17 136 L7 162 L18 188 L5 214 L16 240 L6 266 L18 292 L10 320 L24 320 Z')

            .auth__panel
                .auth__panel-inner
                    h2.heading-secondary.ma-bt-lg Create your account
                    p.auth__hint Already have one? #[a(href='/loginForm') Log in instead]

                    form.form.form--signup
                        .form__group.form__group--float
                            input#name.form__input(type='text', placeholder=' ', required, name='name')
                            label.form__label(for='name') Full name
                        .form__group.form__group--float
                            input#email.form__input(type='email', placeholder=' ', required, name='email')
                            label.form__label(for='email') Email address
                        .form__group.form__group--float
                            input#password.form__input(type='password', placeholder=' ', required, minlength='8', name='password')
                            label.form__label(for='password') Password
                            button.form__toggle(type='button', aria-label='Show password')
                                svg(width='18' height='18' viewBox='0 0 24 24' fill='none')
                                    path(stroke='currentColor' stroke-width='2' d='M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z')
                                    circle(cx='12' cy='12' r='3' stroke='currentColor' stroke-width='2')
                        .form__hint At least 8 characters.
                        .form__group.form__group--float.ma-bt-md
                            input#passwordConfirm.form__input(type='password', placeholder=' ', required, minlength='8', name='passwordConfirm')
                            label.form__label(for='passwordConfirm') Confirm password
                        .form__group
                            button.btn.btn--green(type='submit') Sign up
                        p.auth__terms By signing up you agree to our #[a(href='#') Terms] and #[a(href='#') Privacy Policy].
