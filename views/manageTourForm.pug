extends base

block append head
    // مكتبة Leaflet لتحديد الموقع على الخريطة مباشرة
    link(rel='stylesheet', href='https://unpkg.com/leaflet@1.9.4/dist/leaflet.css')
    script(src='https://unpkg.com/leaflet@1.9.4/dist/leaflet.js')

block content
    main.main
        .admin-view
            .admin-view__header
                h2.heading-secondary= tour ? 'Edit tour' : 'New tour'
                a.btn.btn--small.btn--ghost(href='/manage-tours') ← Back to list

            .admin-form-card
                form.form#tourForm(data-tour-id=tour ? tour.id : '')

                    .admin-form-section
                        h3.admin-form-section__title Basic details
                        .admin-form-grid
                            .form__group
                                label.form__label(for='name') Tour name
                                input#name.form__input(type='text', name='name', minlength='10', maxlength='40', required, value=tour ? tour.name : '')

                            .form__group
                                label.form__label(for='summary') Short summary
                                input#summary.form__input(type='text', name='summary', required, value=tour ? tour.summary : '')

                            .form__group
                                label.form__label(for='duration') Duration (days)
                                input#duration.form__input(type='number', name='duration', min='1', required, value=tour ? tour.duration : '')

                            .form__group
                                label.form__label(for='maxGroupSize') Max group size
                                input#maxGroupSize.form__input(type='number', name='maxGroupSize', min='1', required, value=tour ? tour.maxGroupSize : '')

                            .form__group
                                label.form__label(for='difficulty') Difficulty
                                select#difficulty.form__input(name='difficulty', required)
                                    option(value='easy', selected=tour && tour.difficulty==='easy') Easy
                                    option(value='medium', selected=tour && tour.difficulty==='medium') Medium
                                    option(value='difficult', selected=tour && tour.difficulty==='difficult') Difficult

                            .form__group
                                label.form__label(for='startDate') First start date
                                - const startDateVal = tour && tour.startDates && tour.startDates[0] ? new Date(tour.startDates[0]).toISOString().split('T')[0] : ''
                                input#startDate.form__input(type='date', name='startDate', required=!tour, value=startDateVal)

                            .form__group
                                label.form__label(for='price') Price ($)
                                input#price.form__input(type='number', name='price', min='0', required, value=tour ? tour.price : '')

                            .form__group
                                label.form__label(for='priceDiscount') Discount price ($, optional)
                                input#priceDiscount.form__input(type='number', name='priceDiscount', min='0', value=tour && tour.priceDiscount ? tour.priceDiscount : '')

                    .admin-form-section
                        h3.admin-form-section__title Tour guides
                        p.form__hint Select everyone who'll be leading this tour.
                        .guide-checkbox-list
                            if allGuides && allGuides.length
                                each guide in allGuides
                                    - const isChecked = tour && tour.guides && tour.guides.some(g => (g._id || g).toString() === guide.id.toString())
                                    label.guide-checkbox-item
                                        input.guide-checkbox-item__input(type='checkbox', name='guides', value=guide.id, checked=isChecked)
                                        span.guide-checkbox-item__box
                                            svg(viewBox='0 0 24 24' fill='none')
                                                path(stroke='currentColor' stroke-width='3' stroke-linecap='round' stroke-linejoin='round' d='M5 13l4 4L19 7')
                                        span.guide-checkbox-item__info
                                            span.guide-checkbox-item__name= guide.name
                                            span.guide-checkbox-item__role= guide.role
                            else
                                p.form__hint No guides available yet.

                    .admin-form-section
                        h3.admin-form-section__title Location
                        p.form__hint Click anywhere on the map below to set Latitude &amp; Longitude automatically — or type them in and the pin will follow.
                        .admin-form-grid
                            .form__group
                                label.form__label(for='locationDescription') Location name / address
                                - const locDesc = tour && tour.startLocation ? tour.startLocation.description : ''
                                input#locationDescription.form__input(type='text', name='locationDescription', placeholder='e.g. Miami, USA', required=!tour, value=locDesc)

                            .form__group
                                label.form__label(for='lat') Latitude
                                - const latVal = tour && tour.startLocation && tour.startLocation.coordinates ? tour.startLocation.coordinates[1] : ''
                                input#lat.form__input(type='number', name='lat', step='any', placeholder='25.7617', required=!tour, value=latVal)

                            .form__group
                                label.form__label(for='lng') Longitude
                                - const lngVal = tour && tour.startLocation && tour.startLocation.coordinates ? tour.startLocation.coordinates[0] : ''
                                input#lng.form__input(type='number', name='lng', step='any', placeholder='-80.1918', required=!tour, value=lngVal)

                        #adminMap.admin-map

                    .admin-form-section
                        h3.admin-form-section__title Description
                        textarea#description.form__input(name='description', rows='5')= tour ? tour.description : ''

                    if !tour
                        .admin-form-section
                            h3.admin-form-section__title Photos
                            .admin-form-grid
                                .form__group
                                    label.form__label(for='imageCover') Cover image
                                    input#imageCover.form__input.form__input--file(type='file', name='imageCover', accept='image/*', required)
                                    p.form__hint JPG or PNG. It'll be resized automatically.

                                .form__group
                                    label.form__label(for='images') Gallery photos (up to 3)
                                    input#images.form__input.form__input--file(type='file', name='images', accept='image/*', multiple)

                    .form__group.right.admin-form-actions
                        span#formStatus.admin-form-status
                        button#createTourBtn.btn.btn--small.btn--green(type='submit')= tour ? 'Save changes' : 'Create tour'

block append scripts
    script(src='https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js')
    script(src='/js/manageTourForm.js')
