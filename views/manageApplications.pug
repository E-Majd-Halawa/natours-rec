extends base

block content
  main.main
    .user-view
      .user-view__content
        .user-view__form-container
          h2.heading-secondary.ma-bt-md Manage Applications

          if applications && applications.length > 0
            table.table.applications-table
              thead
                tr
                  th Applicant Name
                  th Email
                  th CV / Resume
                  th Action
              tbody
                each user in applications
                  tr
                    td= user.name
                    td= user.email
                    td
                      if user.cvUrl || user.cv
                        a.btn-text(href=`${user.cvUrl || user.cv}` target='_blank' rel='noopener noreferrer') Download CV
                      else
                        span.text-muted No CV
                    td
                      div.action-buttons
                        button.btn.btn--small.btn--green.btn--accept-app(data-user-id=user._id) Accept
                        button.btn.btn--small.btn--red.btn--delete-app(data-user-id=user._id) Reject

          else
            .no-applications
              p.text-muted No pending guide applications at the moment.

  script.
    document.addEventListener('DOMContentLoaded', () => {
      const applicationsTable = document.querySelector('.applications-table');
      if (!applicationsTable) return;

      applicationsTable.addEventListener('click', async (e) => {
        // 1) القبول وتحديث صلاحية المستخدم لـ Guide
        const acceptBtn = e.target.closest('.btn--accept-app');
        if (acceptBtn) {
          e.preventDefault();
          const userId = acceptBtn.dataset.userId;

          if (!confirm('Are you sure you want to approve this applicant as a guide?')) return;

          try {
            acceptBtn.disabled = true;
            acceptBtn.textContent = 'Accepting...';

            const res = await axios({
              method: 'PATCH',
              url: `/api/v1/users/${userId}`,
              data: {
                role: 'guide'
              }
            });

            if (res.data.status === 'success') {
              alert('User has been successfully updated to Guide!');
              window.location.reload();
            }
          } catch (err) {
            acceptBtn.disabled = false;
            acceptBtn.textContent = 'Accept';
            alert(`Error: ${err.response?.data?.message || err.message}`);
          }
        }

        // 2) الرفض وحذف طلب التقديم عبر الـ Endpoint المخصص
        const deleteBtn = e.target.closest('.btn--delete-app');
        if (deleteBtn) {
          e.preventDefault();
          const userId = deleteBtn.dataset.userId;

          if (!confirm('Are you sure you want to reject and delete this application?')) return;

          try {
            deleteBtn.disabled = true;
            deleteBtn.textContent = 'Rejecting...';

            const res = await axios({
              method: 'DELETE',
              url: `/api/v1/users/delete-application/${userId}`
            });

            if (res.data.status === 'success') {
              window.location.reload();
            }
          } catch (err) {
            deleteBtn.disabled = false;
            deleteBtn.textContent = 'Reject';
            alert(`Error: ${err.response?.data?.message || err.message}`);
          }
        }
      });
    });