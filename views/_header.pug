header.header 
    nav.nav.nav--tour
        a.nav__el(href='/') All Tours
    .header__logo 
        img(src='/img/logo-white.png' alt='Natours logo')
    nav.nav.nav--user 
        if user
            a.nav__el.nav__el--logout.nav__el--cta(href='/') Log out
            a.nav__el(href='/me')
                img.nav__user-img.nav__el(src=`/img/users/${user.photo}` alt=`Photo of ${user.name}`)
                span #{user.name.split(' ')[0]}
        else        
            a.nav__el(href='/loginForm') Log in
            a.nav__el.nav__el--cta(href='/signup') Sign up