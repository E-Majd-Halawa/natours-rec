{
  "name": "natours",
  "version": "1.0.0",
  "description": "Learning node, express and mongoDB",
  "main": "./public/js/bundle.js",
  "targets": {
    "default": {
      "context": "browser",
      "distDir": "./public/js/dist",
      "includeNodeModules": true
    }
  },
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "debug": "ndb server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "watch:js": "parcel watch ./public/js/index.js --dist-dir ./public/js/dist --no-source-maps",
    "build:js": "parcel build ./public/js/index.js --dist-dir ./public/js/dist --no-source-maps"
  },
  "author": "\"Majd Halawa\"",
  "license": "ISC",
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "dependencies": {
    "@babel/polyfill": "^7.12.1",
    "@sendgrid/mail": "^8.1.6",
    "axios": "^0.21.4",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^4.22.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "html-to-text": "^10.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^5.13.23",
    "morgan": "^1.10.1",
    "multer": "^2.2.0",
    "nodemailer": "^8.0.7",
    "pug": "^3.0.4",
    "sharp": "^0.35.3",
    "slugify": "^1.6.9",
    "stripe": "^22.3.2",
    "validator": "^13.15.35",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.2",
    "buffer": "^6.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "parcel": "^2.16.4",
    "prettier": "^3.8.3"
  }
}
